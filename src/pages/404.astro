---
import Layout from "../layouts/Layout.astro";
import { getSite } from "../lib/content";

const site = await getSite();
---

<Layout title={`Página no encontrada: ${site.name}`} description={site.description} hidden>
  <main>
    <p class="t-marca" translate="no">{site.name}</p>
    <h1 class="t-sub">Aquí no hay nada en órbita</h1>
    <p>La página que buscas no existe o cambió de lugar.</p>
    <a class="cta" href="/">Volver al inicio</a>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 28px;
    box-sizing: border-box;
    min-height: 100vh;
    padding: 40px var(--margen);
  }
  h1,
  p {
    margin: 0;
  }
</style>
