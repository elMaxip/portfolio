---
import About from "../components/About.astro";
import Closing from "../components/Closing.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Process from "../components/Process.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Appearance from "../islands/Appearance";
import Layout from "../layouts/Layout.astro";
import { getSite } from "../lib/content";
import "../styles/appearance.css";

const site = await getSite();
---

<Layout title={site.title} description={site.description}>
  <a class="salto" href="#proyectos">Ir a los proyectos</a>
  <Nav />
  <Hero />
  <main>
    <About />
    <Projects />
    <Process />
    <Services />
  </main>
  <Closing />
  <Appearance client:idle={{ timeout: 1500 }} />
</Layout>

<script>
  import "../engine/start";
</script>
