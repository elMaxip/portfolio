---
import { getSite, getSteps } from "../lib/content";
import { progressBar } from "../lib/format";
import SectionTitle from "./SectionTitle.astro";
const site = await getSite();
const steps = await getSteps();
const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<section id="proceso" data-zona aria-labelledby="titulo-proceso">
  <SectionTitle id="titulo-proceso" text={site.process.title} class="centrado" />
  <ol role="list">
    {
      steps.map(({ id, data }) => (
        <li>
          <div class="cuerpo" aria-hidden="true">
            <canvas data-escena={id} />
            <svg class="lamina solo-js" viewBox="-50 -50 100 100" data-apunta>
              <circle class="aro" r="48.5" stroke-dasharray="1 5" />
              {ticks.map((a) => <path d={a % 90 ? "M0 -48.5V-47" : "M0 -48.5V-45"} transform={`rotate(${a})`} />)}
              <g class="carta-aguja">
                <path d="M0 -48.5V-52" stroke="var(--secundario)" />
                <circle cy="-48.5" r="1.1" fill="var(--secundario)" stroke="none" />
              </g>
            </svg>
          </div>
          <span class="barra" aria-hidden="true">
            {progressBar(data.progress)}
          </span>
          <h3 class="t-paso">{data.title}</h3>
          <p>{data.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section {
    padding: clamp(64px, 8vw, 120px) var(--margen);
  }
  .centrado {
    margin: 0 auto 48px;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 48px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }
  canvas {
    display: block;
    width: 100%;
    height: 360px;
  }
  .barra {
    color: var(--acento);
    font-family: var(--f-mono);
    font-size: 1.0625rem;
    white-space: pre;
  }
  h3 {
    margin: 0;
  }
  p {
    max-width: 36ch;
    margin: 0;
    color: var(--secundario);
    text-wrap: balance;
  }
  @media (max-width: 759px) {
    .centrado {
      margin-bottom: 32px;
    }
    ol {
      row-gap: 40px;
    }
    li {
      gap: 12px;
    }
    canvas {
      height: 224px;
    }
  }
</style>
