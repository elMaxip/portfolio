---
import { getSite } from "../lib/content";
const site = await getSite();
---

<header data-bloque="1">
  <a class="nav t-marca" href="#inicio" translate="no"><span aria-hidden="true">&gt;&nbsp;</span>{site.name}</a>
  <button class="tecla solo-js" type="button" data-pausar
    ><span data-accion>Pausar</span> <span class="resto">animación</span></button
  >
</header>

<style>
  header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 32px;
    padding: 20px var(--margen);
  }
  .t-marca {
    margin-inline-start: -10px;
  }
  .tecla {
    min-height: 44px;
    padding: 0 16px;
    background: var(--fondo);
  }
  @media (max-width: 1099px) {
    header {
      /* Espacio para el dial de navegación */
      padding-block: 16px;
      padding-right: calc(max(16px, env(safe-area-inset-right)) + 60px);
    }
    .tecla {
      min-height: 48px;
    }
  }
  @media (max-width: 759px) {
    .tecla {
      padding: 0 12px;
      font-size: 0.9375rem;
    }
    /* No cabe: queda solo para los lectores de pantalla */
    .resto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (max-width: 389px) {
    /* "Reanudar" sigue junto a la marca */
    header {
      gap: 4px 12px;
    }
  }
  @media (max-width: 359px) {
    .tecla {
      padding: 0 8px;
      font-size: 0.875rem;
    }
    header .t-marca {
      padding-inline: 4px;
      margin-inline-start: -4px;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // El motor observa data-paused en <html>
  const button = document.querySelector<HTMLButtonElement>("[data-pausar]");
  const action = button?.querySelector("[data-accion]");
  button?.addEventListener("click", () => {
    const paused = document.documentElement.toggleAttribute("data-paused");
    if (action) action.textContent = paused ? "Reanudar" : "Pausar";
  });
</script>
