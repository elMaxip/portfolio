---
import { getSite } from "../lib/content";
const site = await getSite();
---

<header data-bloque="1">
  <a class="nav t-marca" href="#inicio" translate="no"><span aria-hidden="true">&gt;&nbsp;</span>{site.name}</a>
  <nav class="menu" aria-label="Principal">
    <a class="nav" href="#sobre-mi">Sobre mí</a>
    <a class="nav" href="#proyectos">Proyectos</a>
    <a class="nav" href="#precios">Precios</a>
    <button class="tecla solo-js" type="button" data-pausar>Pausar</button>
  </nav>
</header>

<style>
  header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 32px;
    padding: 20px var(--margen);
  }
  .t-marca {
    margin-inline-start: -10px;
  }
  .menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-weight: 500;
  }
  .tecla {
    min-height: 44px;
    padding: 0 16px;
    background: var(--fondo);
  }
  @media (max-width: 759px) {
    .menu {
      gap: 4px 6px;
      margin-inline-start: -4px;
      font-size: 0.9375rem;
    }
    .menu .nav {
      padding-inline: 4px;
    }
    .tecla {
      padding: 0 10px;
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  // El motor (etapa 3) observa data-paused en <html>
  const button = document.querySelector<HTMLButtonElement>("[data-pausar]");
  button?.addEventListener("click", () => {
    const paused = document.documentElement.toggleAttribute("data-paused");
    button.textContent = paused ? "Reanudar" : "Pausar";
  });
</script>
