---
import { getSite } from "../lib/content";
import SectionTitle from "./SectionTitle.astro";
const { about } = await getSite();
---

<section id="sobre-mi" aria-labelledby="titulo-sobre-mi">
  <div class="retrato" aria-hidden="true">
    <canvas class="escena" data-escena="retrato"></canvas>
    <svg class="lamina solo-js" data-luz>
      <circle r="1.5" stroke-dasharray="1 5"></circle>
      <circle r="2.3" stroke-dasharray="8 5 1 5"></circle>
      <path d="M-2.6 0H2.6M0 -2.6V2.6" stroke-dasharray="1 6"></path>
      <path d="M1.5 -.06V.06M2.3 -.06V.06M-1.5 -.06V.06M-2.3 -.06V.06"></path>
      {[-2.1, -1.45, 1.45, 2.1].map((b) => <path class="rayo-fijo" data-b={b} />)}
      <path class="rayo" data-rayo></path>
    </svg>
    <span class="lectura solo-js" data-lectura></span>
  </div>
  <div class="textos">
    <SectionTitle id="titulo-sobre-mi" text={about.title} size="t-sub" />
    <p class="destacado t-grande">{about.highlights.map((h) => <><span class="luz">{h}</span>{" "}</>)}</p>
    <p class="detalle">{about.text}</p>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 72px;
    padding: clamp(40px, 5vw, 72px) var(--margen);
    scroll-margin-top: 24px;
  }
  .retrato {
    position: relative;
    flex: 1 1 340px;
    min-width: 0;
    max-width: 560px;
    aspect-ratio: 1 / 1;
  }
  .textos {
    flex: 2 1 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    min-width: 0;
  }
  .destacado {
    margin: 0;
    font-weight: 500;
  }
  .detalle {
    max-width: 62ch;
    margin: 0;
    color: var(--secundario);
    text-wrap: pretty;
  }
  @media (max-width: 759px) {
    section {
      gap: 20px;
      padding-block: 24px 40px;
      scroll-margin-top: 0;
    }
    /* El agujero negro ocupa el alto que dejan los textos, para que se vean completos */
    .retrato {
      flex-basis: 100%;
      max-width: none;
      height: clamp(110px, 100svh - 510px, 320px);
      aspect-ratio: auto;
    }
    .textos {
      gap: 20px;
    }
  }
</style>
