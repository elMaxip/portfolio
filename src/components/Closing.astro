---
import { getSite } from "../lib/content";
import Footer from "./Footer.astro";
const site = await getSite();

interface Props {
  /** Sin props, el cierre de la página para clientes. El slot reemplaza el botón de WhatsApp. */
  closing?: { title: string; text: string };
}
const { closing = site.closing } = Astro.props;
---

<div class="cierre" id="contacto">
  <canvas class="escena" data-escena="horizonte" aria-hidden="true"></canvas>
  <section aria-labelledby="titulo-cierre">
    <h2 id="titulo-cierre" class="t-final" aria-label={closing.title} data-bloque="1">
      <span aria-hidden="true" data-decrypt="1">{closing.title}</span>
    </h2>
    <p data-bloque="1">{closing.text}</p>
    {
      Astro.slots.has("default") ? (
        <slot />
      ) : (
        <a class="cta" data-bloque="1" href={site.whatsappHref}>
          {site.whatsapp.label}
        </a>
      )
    }
  </section>
  <Footer />
</div>

<style>
  .cierre {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
    min-height: 820px;
    overflow: hidden;
    background: var(--fondo);
  }
  /* Con formulario, al saltar a #contacto se omite casi todo el relleno de arriba
     para que el formulario entre completo en la pantalla */
  .cierre:has(.formulario) {
    scroll-margin-top: calc(16px - clamp(72px, 8vw, 120px));
  }
  section {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
    /* Los 340 px de abajo son para el horizonte */
    padding: clamp(72px, 8vw, 120px) var(--margen) 340px;
    text-align: center;
  }
  h2 {
    margin: 0;
    white-space: nowrap;
  }
  p {
    max-width: 38ch;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: balance;
  }
  @media (max-width: 759px) {
    .cierre {
      min-height: 0;
    }
    section {
      gap: 28px;
      padding-bottom: 290px;
    }
  }
</style>

<script>
  // Si el título y el formulario no caben juntos en la pantalla (celular, notebook bajo),
  // el salto a #contacto deja el formulario completo a la vista en vez del título.
  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest?.('a[href="#contacto"]');
    const form = document.querySelector<HTMLElement>("#contacto .formulario");
    const title = document.getElementById("titulo-cierre");
    if (!link || !form || !title) return;
    const need = form.getBoundingClientRect().bottom - title.getBoundingClientRect().top + 32;
    if (need <= innerHeight) return;
    e.preventDefault();
    history.pushState(null, "", "#contacto");
    form.scrollIntoView({ block: "start" });
  });
</script>
