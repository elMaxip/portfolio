---
import Appearance from "../islands/Appearance";
import { getSite } from "../lib/content";
import "../styles/appearance.css";
const { footer } = await getSite();
---

<footer data-bloque="1">
  <p>{footer.text}</p>
  <div>
    {footer.links.map((l) => <a class="nav" href={l.href}>{l.label}</a>)}
  </div>
  <Appearance client:idle={{ timeout: 1500 }} />
</footer>

<style>
  footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 32px;
    box-sizing: border-box;
    min-height: 80px;
    padding: 10px var(--margen);
    border-top: 2px dashed var(--borde-tenue);
    background: var(--fondo);
    font-size: 1rem;
  }
  p {
    margin: 0;
  }
  div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-inline: -10px;
  }
  /* En celular todo va al centro, en columna, como el cierre de arriba */
  @media (max-width: 759px) {
    footer {
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      padding-block: 20px 24px;
      text-align: center;
    }
    div {
      justify-content: center;
      column-gap: 0;
    }
  }
</style>
