// Cloudflare (Workers y Pages): el sitio es estático, así que solo se publica la carpeta dist
// que deja `pnpm run build`. Sin este archivo, `wrangler deploy` intenta convertir el proyecto
// en una app con servidor (astro add cloudflare) y falla.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    // Las rutas que no existen muestran la página 404 del sitio
    "not_found_handling": "404-page"
  }
}
